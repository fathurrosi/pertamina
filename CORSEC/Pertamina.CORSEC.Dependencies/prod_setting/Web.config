<configuration>
  <configSections>
    <section name="Custom.Config" type="Custom.Config.CustomSection, Custom.Config" />
  </configSections>
  <Custom.Config>
    <Default applicationName="PPID" connectionStringName="ConnString" />
    <Entities>
      <add assembly="DBHelper" connectionStringName="ConnString" />
    </Entities>
  </Custom.Config>
  <appSettings>
    <clear />
    <add key="Domain" value="https://eppid.pertamina.com" />
  </appSettings>
  <connectionStrings>
    <clear />
    <!--<add name="ConnString" connectionString="Data Source=H6364640317VM\SQLEXPRESS;Initial Catalog=ppid;Persist Security Info=True;User ID=sa;Password=saP@ssw0rd!;" providerName="System.Data.SqlClient" />-->
