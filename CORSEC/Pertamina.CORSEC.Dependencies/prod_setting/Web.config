    <add name="ConnString" connectionString="Server=tcp:sql-eppid.database.windows.net,1433;Initial Catalog=db-eppid.pertamina.com;Persist Security Info=False;User ID=dbeppidapp;Password=dbeppid.pass123;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;" providerName="System.Data.SqlClient" />
